NAME          := qu33ph
GAME_TITLE    := Qu33ph DS
GAME_SUBTITLE := Flick markers
GAME_AUTHOR   := Qu33ph
SOURCEDIRS    := source
NITROFSDIR    := nitrofs

# BlocksDS SDK
BLOCKSDS ?= /opt/blocksds/core
RULES ?= $(BLOCKSDS)/sys/default_makefiles/rom_arm9/Makefile

ROM := qu33ph.nds
R4_ROM := qu33ph_r4tf.nds
DLDI ?= $(BLOCKSDS)/sys/dldi_r4/r4tf.dldi

.PHONY: all clean dldipatch FORCE

all: $(ROM)

$(ROM): FORCE
	@echo "Preparing Qu33ph arcade packs..."
	rm -f source/assets_mini.c
	mkdir -p nitrofs
	find . -name '*.pak' -not -path './nitrofs/*' -exec cp {} nitrofs/ \;
	test -f nitrofs/mini.pak
	test -f nitrofs/ball.pak
	@echo "Building with BlocksDS: $(RULES)"
	$(MAKE) -f "$(RULES)" NITROFSDIR=nitrofs

# Patch a COPY with the original-R4/R4TF driver shipped by BlocksDS.
# For an R4i/clone, set DLDI=/path/to/the/correct/card.dldi instead.
dldipatch: $(ROM)
	cp "$(ROM)" "$(R4_ROM)"
	"$(BLOCKSDS)/tools/dldipatch/dldipatch" patch "$(DLDI)" "$(R4_ROM)"

clean:
	$(MAKE) -f "$(RULES)" clean || true
	rm -f "$(ROM)" "$(R4_ROM)"
	rm -rf nitrofs

FORCE:
